{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "html.schema.json",
  "title": "html v3 artifact-reference payload",
  "type": "object",
  "allOf": [
    { "$ref": "envelope.schema.json" },
    {
      "properties": {
        "type": { "const": "html" },
        "work_class": { "const": "CONTINUATION" },
        "payload": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "hit_id",
            "plan_id",
            "original_query",
            "query_term",
            "requested_url",
            "final_url",
            "title",
            "snippet",
            "published_at",
            "source",
            "level",
            "artifact_ref",
            "checksum",
            "content_type",
            "byte_size"
          ],
          "properties": {
            "hit_id": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^\\S+$" },
            "plan_id": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^\\S+$" },
            "original_query": { "type": "string", "minLength": 1, "maxLength": 500 },
            "query_term": { "type": "string", "minLength": 1, "maxLength": 500 },
            "requested_url": {
              "type": "string",
              "minLength": 1,
              "maxLength": 2048,
              "format": "uri",
              "pattern": "^https?://\\S+$"
            },
            "final_url": {
              "type": "string",
              "minLength": 1,
              "maxLength": 2048,
              "format": "uri",
              "pattern": "^https?://\\S+$"
            },
            "title": { "type": "string", "maxLength": 500 },
            "snippet": { "type": "string", "maxLength": 2000 },
            "published_at": {
              "anyOf": [
                { "const": "" },
                { "type": "string", "format": "date" }
              ]
            },
            "source": { "type": "string", "minLength": 1, "maxLength": 500 },
            "level": { "type": "integer", "minimum": 0, "maximum": 4294967295 },
            "artifact_ref": {
              "type": "string",
              "minLength": 1,
              "maxLength": 512,
              "pattern": "^[A-Za-z0-9._:-]+(?:/[A-Za-z0-9._:-]+)*$",
              "not": { "pattern": "(^|/)\\.{1,2}(/|$)|^/|^[A-Za-z]:" }
            },
            "checksum": {
              "type": "string",
              "minLength": 64,
              "maxLength": 64,
              "pattern": "^[a-f0-9]{64}$"
            },
            "content_type": {
              "type": "string",
              "minLength": 1,
              "maxLength": 128,
              "pattern": "^[^\\s/]+/[^\\s/]+$"
            },
            "byte_size": { "type": "integer", "minimum": 0, "maximum": 20971520 }
          }
        }
      },
      "required": ["payload"]
    }
  ]
}
