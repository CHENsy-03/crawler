  "dial_cases": [
    {
      "id": "dial-001",
      "addresses": [
        "93.184.216.34"
      ],
      "port": 443,
      "fail_first": false,
      "expected_sequence": [
        "93.184.216.34"
      ],
      "expected_reason": ""
    },
    {
      "id": "dial-002",
      "addresses": [
        "1.1.1.1",
        "8.8.8.8"
      ],
      "port": 443,
      "fail_first": true,
      "expected_sequence": [
        "1.1.1.1",
        "8.8.8.8"
      ],
      "expected_reason": ""
    },
    {
      "id": "dial-003",
      "addresses": [
        "1.1.1.1",
        "8.8.8.8"
      ],
      "port": 443,
      "fail_first": false,
      "fail_all": true,
      "expected_sequence": [
        "1.1.1.1",
        "8.8.8.8"
      ],
      "expected_reason": "connection_failed"
    },
    {
      "id": "dial-004",
      "addresses": [],
      "port": 443,
      "fail_first": false,
      "expected_sequence": [],
      "expected_reason": "empty_addresses"
    },
    {
      "id": "dial-005",
      "addresses": [
        "2606:4700:4700::1111"
      ],
      "port": 443,
      "fail_first": false,
      "expected_sequence": [
        "2606:4700:4700::1111"
      ],
      "expected_reason": ""
    },
    {
      "id": "dial-006",
      "addresses": [
        "2606:4700:4700::1111",
        "8.8.8.8",
        "1.1.1.1"
      ],
      "port": 443,
      "fail_first": false,
      "expected_sequence": [
        "1.1.1.1"
      ],
      "expected_reason": ""
    }
  ],
  "authority_cases": [
    {
      "id": "auth-001",
      "request_authority": "example.com",
      "scheme": "http",
      "host": "example.com",
      "port": 80,
      "expected_reason": ""
    },
    {
      "id": "auth-002",
      "request_authority": "other.example",
      "scheme": "http",
      "host": "example.com",
      "port": 80,
      "expected_reason": "authority_mismatch"
    },
    {
      "id": "auth-003",
      "request_authority": "example.com:8080",
      "scheme": "http",
      "host": "example.com",
      "port": 80,
      "expected_reason": "authority_mismatch"
    },
    {
      "id": "auth-004",
      "request_authority": "https://example.com/",
      "scheme": "http",
      "host": "example.com",
      "port": 80,
      "expected_reason": "scheme_mismatch"
    }
  ],
  "tls_cases": [
    {
      "id": "tls-001",
      "server_name": "fixture.example",
      "expected_server_name": "fixture.example",
      "insecure_skip_verify": false,
      "expected_reason": ""
    },
    {
      "id": "tls-002",
      "server_name": "fixture.example",
      "expected_server_name": "fixture.example",
      "insecure_skip_verify": true,
      "expected_reason": "insecure_tls_context"
    },
    {
      "id": "tls-003",
      "server_name": "127.0.0.1",
      "expected_server_name": "fixture.example",
      "insecure_skip_verify": false,
      "expected_reason": "tls_server_name_mismatch"
    }
  ]
