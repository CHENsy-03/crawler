  "host_header_cases": [
    {
      "id": "host-001",
      "scheme": "http",
      "host": "example.com",
      "port": 80,
      "request_host": "",
      "expected": "example.com"
    },
    {
      "id": "host-002",
      "scheme": "https",
      "host": "example.com",
      "port": 443,
      "request_host": "",
      "expected": "example.com"
    },
    {
      "id": "host-003",
      "scheme": "https",
      "host": "example.com",
      "port": 8443,
      "request_host": "",
      "expected": "example.com:8443"
    },
    {
      "id": "host-004",
      "scheme": "http",
      "host": "93.184.216.34",
      "port": 80,
      "request_host": "",
      "expected": "93.184.216.34"
    },
    {
      "id": "host-005",
      "scheme": "http",
      "host": "93.184.216.34",
      "port": 8080,
      "request_host": "",
      "expected": "93.184.216.34:8080"
    },
    {
      "id": "host-006",
      "scheme": "https",
      "host": "2606:4700:4700::1111",
      "port": 443,
      "request_host": "",
      "expected": "[2606:4700:4700::1111]"
    },
    {
      "id": "host-007",
      "scheme": "https",
      "host": "2606:4700:4700::1111",
      "port": 8443,
      "request_host": "",
      "expected": "[2606:4700:4700::1111]:8443"
    },
    {
      "id": "host-008",
      "scheme": "http",
      "host": "example.com",
      "port": 80,
      "request_host": "example.com",
      "expected": "example.com"
    },
    {
      "id": "host-009",
      "scheme": "http",
      "host": "example.com",
      "port": 80,
      "request_host": "other.example",
      "expected_reason": "host_header_mismatch"
    },
    {
      "id": "host-010",
      "scheme": "https",
      "host": "xn--bcher-kva.example",
      "port": 443,
      "request_host": "",
