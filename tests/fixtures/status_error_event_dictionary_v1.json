    {"id":"DEV002_DECISION_005","source":"V1.0 9.3 and V1.1 5","current_value":"unfrozen state machine","target_value":"transition guards owned by DEV-204","decision":"State transition guards and complete state machine behavior are deferred to DEV-204.","scope":"state machine","work_package":"DEV-204"},
    {"id":"DEV003_CONTRACT_FIX_001","source":"V1.0 7.4 and 14.5; DEV-003 P4 audit and CONTRACT-FIX-B1","current_value":"over_limit=429; no dedicated SSE history-expired code","target_value":"task_limit_exceeded=422; event_history_expired=410","decision":"Adds two scenario-specific canonical error codes while preserving all 61 existing error records. New /api/v1 task hard-limit errors use task_limit_exceeded=422. SSE Last-Event-ID outside retained history uses event_history_expired=410. NEVER means no automatic retry of the same request or expired cursor; clients may revise task parameters or obtain a fresh task snapshot before resuming.","scope":"public HTTP errors for task hard limits and SSE resumption","work_package":"DEV-003 shared contract fix"}
