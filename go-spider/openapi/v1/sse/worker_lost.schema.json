{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "worker_lost.schema.json",
  "title": "worker_lost",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "event_version",
    "occurred_at",
    "task_id",
    "attempt_id",
    "heartbeat_expired_at"
  ],
  "properties": {
    "event_version": {
      "type": "string",
      "const": "1"
    },
    "occurred_at": {
      "type": "string",
      "format": "date-time"
    },
    "task_id": {
      "type": "string",
      "minLength": 26,
      "maxLength": 26,
      "pattern": "^[0-7][0-9A-HJKMNP-TV-Z]{25}$"
    },
    "attempt_id": {
      "type": "string",
      "minLength": 26,
      "maxLength": 26,
      "pattern": "^[0-7][0-9A-HJKMNP-TV-Z]{25}$"
    },
    "heartbeat_expired_at": {
      "type": "string",
      "format": "date-time"
    }
  }
}
